{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure",
            "type": "shell",
            "command": "cmake -B build",
            "group": "build",
            "presentation": { "reveal": "always" }
        },
        {
            "label": "cmake build",
            "type": "shell",
            "command": "cmake --build build",
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "cmake configure",
            "presentation": { "reveal": "always" }
        }
    ]
}
